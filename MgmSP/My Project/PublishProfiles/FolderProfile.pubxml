<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DeleteExistingFiles>False</DeleteExistingFiles>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>\\SAP-NEW-TST\B1Solutuin</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net40</TargetFramework>
  </PropertyGroup>
  <!-- 排除 Web.config，避免發布時覆蓋伺服器設定 -->
  <ItemGroup>
    <ExcludeFromPackageFiles Include="Web.config">
      <FromTarget>Project</FromTarget>
    </ExcludeFromPackageFiles>
  </ItemGroup>
  <!-- 排除 Agent 工作區（副本、藍圖等），這些只用於開發協作 -->
  <ItemGroup>
    <Content Remove=".agent-workspace\**" />
    <None Remove=".agent-workspace\**" />
    <Content Remove=".claude\**" />
    <None Remove=".claude\**" />
  </ItemGroup>
</Project>