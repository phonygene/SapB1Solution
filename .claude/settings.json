{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/version-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote:*)",

      "Bash(dir:*)",
      "Bash(type:*)",
      "Bash(where:*)",
      "Bash(node:*)",
      "Bash(dotnet:*)",
      "Bash(npm list:*)",
      "Bash(npm show:*)",
      "Bash(npm --version:*)",

      "Edit(.agent-workspace/**)",
      "Write(.agent-workspace/**)",
      "Edit(work-logs/**)",
      "Write(work-logs/**)",
      "Edit(skills/**)",
      "Write(skills/**)",
      "Edit(.claude/shared/**)",
      "Write(.claude/shared/**)",

      "Bash(wmic:*)",
      "Bash(taskkill:*)",
      "Bash(cmd.exe:*)",
      "Bash(python:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(sleep:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",

      "mcp__sapb1-sql__sql_query",
      "mcp__sapb1-sql__get_table_info",
      "mcp__sapb1-sql__list_tables",
      "mcp__sapb1-sql__get_db_status",
      "mcp__sapb1-sql__list_backups"
    ],
    "defaultMode": "default"
  }
}
