{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "B1Transaction Schema v1.1",
  "description": "模仿 SAP B1 操作介面的交易表單規格定義",
  "version": "1.1.0",

  "definitions": {
    "fieldAttributes": {
      "type": "object",
      "properties": {
        "editable": {"type": "boolean", "description": "是否可編輯"},
        "searchable": {"type": "boolean", "description": "是否可作為搜尋條件"},
        "updatable": {"type": "boolean", "description": "更新模式時是否可修改"},
        "selectable": {"type": "boolean", "description": "是否可選取"},
        "focusable": {"type": "boolean", "description": "是否可聚焦（Tab 停留）"},
        "required": {"type": "boolean", "description": "是否必填"},
        "visible": {"type": "boolean", "description": "是否可見"}
      }
    },

    "doubleClickBehavior": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["None", "ChooseFromList", "LinkToMaster", "LinkToDoc"],
          "description": "雙擊行為類型"
        },
        "target": {
          "type": "string",
          "description": "目標：ChooseFromList 的物件代碼（如 2-BP）、LinkToMaster 的主檔代碼、LinkToDoc 的 DocEntry"
        },
        "paramsFrom": {
          "type": "array",
          "items": {"type": "string"},
          "description": "參數來源欄位清單"
        },
        "paramMap": {
          "type": "object",
          "description": "參數對應表：{ sourceField: targetParam }"
        }
      }
    },

    "modePolicy": {
      "type": "object",
      "properties": {
        "fieldDefaults": {
          "$ref": "#/definitions/fieldAttributes",
          "description": "該模式下欄位的預設屬性"
        },
        "stateRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {"type": "string", "description": "條件表達式"},
              "set": {
                "type": "object",
                "description": "要設定的屬性"
              }
            }
          },
          "description": "條件覆寫規則"
        }
      }
    }
  },

  "type": "object",
  "properties": {
    "object": {
      "type": "string",
      "const": "B1Transaction",
      "description": "物件類型標識"
    },
    "version": {
      "type": "string",
      "description": "規格版本"
    },
    "meta": {
      "type": "object",
      "properties": {
        "docType": {"type": "string", "description": "單據類型代碼"},
        "title": {"type": "string", "description": "標題"},
        "description": {"type": "string", "description": "說明"}
      }
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["create", "search", "update"]
      },
      "description": "支援的操作模式"
    },
    "ui": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "object",
          "properties": {
            "master": {
              "type": "object",
              "description": "表頭欄位定義"
            },
            "details": {
              "type": "array",
              "description": "明細區塊定義（支援多個 tab）"
            }
          }
        },
        "colorTheme": {
          "type": "object",
          "properties": {
            "editable": {"type": "string", "default": "#FFFFFF"},
            "readonly": {"type": "string", "default": "#F0F0F0"},
            "searchable": {"type": "string", "default": "#FFFFCC"},
            "required": {"type": "string", "default": "#FFEEEE"}
          }
        }
      }
    },
    "modePolicies": {
      "type": "object",
      "properties": {
        "create": {"$ref": "#/definitions/modePolicy"},
        "search": {"$ref": "#/definitions/modePolicy"},
        "update": {"$ref": "#/definitions/modePolicy"}
      },
      "description": "各模式的全域策略"
    }
  },
  "required": ["object", "version", "modes", "ui", "modePolicies"]
}
